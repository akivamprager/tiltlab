# Template: pi/setup_pi.sh fills in @USER@ and @DIR@ and installs it as
# /etc/systemd/system/tiltlab.service. Hold the Pi level while it boots (--zero).
[Unit]
Description=Tilt Lab spirit level + live dashboard
After=network.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @DIR@/tiltlab.py --zero --dashboard --quiet
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
